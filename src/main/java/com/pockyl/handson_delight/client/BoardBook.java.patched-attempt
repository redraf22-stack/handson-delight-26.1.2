package com.pockyl.handson_delight.client;

import com.mojang.blaze3d.platform.InputConstants;
import com.mojang.blaze3d.platform.Window;
import net.minecraft.client.Minecraft;
import net.minecraft.core.Holder;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.nbt.CompoundTag;
import net.minecraft.nbt.ListTag;
import net.minecraft.resources.Identifier;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.ItemStackTemplate;
import net.minecraft.world.item.Items;
import net.minecraft.world.item.crafting.Ingredient;
import net.minecraft.world.level.Level;
import vectorwing.farmersdelight.common.crafting.CuttingBoardRecipe;

import com.pockyl.diegesis.api.client.StationView;
import com.pockyl.handson_delight.FarmersDelightContent;
import com.pockyl.handson_delight.assembly.AssemblyRecipes;
import com.pockyl.handson_delight.station.BoardLogic;
import com.pockyl.handson_delight.station.Cutting;
import com.pockyl.handson_delight.station.CuttingBoardStation;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * The board's book: what can be cut, listed by what comes off (a cabbage leaf: a cabbage and a knife, with everything else the cut
 * gives at the foot), and the dishes put together on it, what goes down first first. The dishes come from the station's data: a
 * dedicated server
 * sends their recipes nowhere else.
 */
final class BoardBook implements RecipeBook.Source {
    /** The dishes' recipes as the server last sent them ({@code CuttingBoardStation.EFFECT_BOOK}): the same for every board. */
    private static ListTag received = new ListTag();
    private static final String DISHES = "dishes";
    private static final String KNIFE = "knife";
    /** Cuts made with anything but a knife: an axe, shears, an addon's rolling pin, all under one tab. */
    private static final String TOOLS = "tools";
    private static final Object LOCK = new Object();
    /** The tag being read, and whether a reader is at work: reading in the background keeps the click from hitching. */
    private static ListTag queued;
    private static boolean reading;
    private static volatile ListTag readFrom;
    private static volatile List<RecipeBook.Page> dishes = List.of();
    /** What goes into the dishes without a page: Modest Meals' meals of free fillings. */
    private static volatile List<Ingredient> unlisted = List.of();
    /** Goes up each time the dishes are read anew: what the drawer shows depends on them. */
    private static volatile int version;
    /** The pages handed out last time, and what they were built from: the same list is given again while nothing changed. */
    private static List<RecipeBook.Page> built = List.of();
    private static int builtVersion = -1;
    private static Level builtLevel;
    private static int builtCuts = -1;
    /** The cuts' pages, read once for the level: opening a board then has nothing to build. */
    private static final Map<Level, List<RecipeBook.Page>> CUTS = new java.util.WeakHashMap<>();
    private static final Object CUTS_LOCK = new Object();

    @Override
    public List<RecipeBook.Page> pages(StationView view) {
        Level level = view.level();
        // The server sends the book again at every click, a new tag with the same content; reading 232 recipes each time is what
        // made the board hitch as it opened. The pages are built once and handed back while neither the dishes nor the level changed.
        List<RecipeBook.Page> dishesNow = dishes(view);
        List<RecipeBook.Page> cutsNow = cuts(level);
        if (builtVersion == version && builtLevel == level && builtCuts == cutsNow.size() && !built.isEmpty()) {
            return built;
        }
        long started = System.nanoTime();
        List<RecipeBook.Page> pages = new ArrayList<>(dishesNow.size() + cutsNow.size());
        pages.addAll(dishesNow);
        pages.addAll(cutsNow);
        built = List.copyOf(pages);
        builtVersion = version;
        builtLevel = level;
        builtCuts = cutsNow.size();
        long spent = (System.nanoTime() - started) / 1_000_000L;
        if (spent >= 10L) {
            com.pockyl.handson_delight.HandsOnDelight.LOGGER.info("board book: {} pages built in {} ms", built.size(), spent);
        }
        return built;
    }

    /** The cuts the board's book lists, read once for the level (a recipe reload makes a new set of recipes, and a new list). */
    static List<RecipeBook.Page> cuts(Level level) {
        synchronized (CUTS_LOCK) {
            List<RecipeBook.Page> done = CUTS.get(level);
            // An empty list read before the client had the recipes stays as "nothing read": it is read again, not kept.
            if (done != null && (!done.isEmpty() || Cutting.all(level).isEmpty())) {
                return done;
            }
        }
        List<RecipeBook.Page> pages = new ArrayList<>();
        for (CuttingBoardRecipe recipe : Cutting.all(level)) {
            List<ItemStack> results = results(recipe);
            if (results.isEmpty()) {
                continue;
            }
            List<Ingredient> ingredients = List.of(recipe.getInput(), Cutting.tool(recipe));
            List<ItemStack> foot = results.size() > 1 ? results : List.of();
            pages.add(new RecipeBook.Page(Cutting.id(level, recipe), results.get(0).copy(), ingredients, foot, null, false,
                    toolKind(recipe)));
        }
        List<RecipeBook.Page> done = List.copyOf(pages);
        synchronized (CUTS_LOCK) {
            CUTS.put(level, done);
        }
        return done;
    }

    /** Reads the cuts ahead of the first open, on a worker thread when the world joins. */
    static void warm(Level level) {
        try {
            cuts(level);
        } catch (RuntimeException broken) {
            com.pockyl.handson_delight.HandsOnDelight.LOGGER.warn("Could not read the board's cuts ahead of time", broken);
        }
    }

    /**
     * The tabs: everything, the dishes, the knife's cuts, and the cuts of every other tool under one tab, shown by the tool most of
     * them take. One tab per tool overflowed the page with addons, which bring axes, shears, pickaxes and their own tools.
     */
    @Override
    public List<RecipeBook.Tab> tabs(StationView view) {
        List<RecipeBook.Tab> tabs = new ArrayList<>();
        // Everything under a compass, as in vanilla's recipe book.
        tabs.add(new RecipeBook.Tab(null, new ItemStack(Items.COMPASS)));
        if (!dishes(view).isEmpty()) {
            tabs.add(new RecipeBook.Tab(DISHES, stack(FarmersDelightContent.id("hamburger"))));
        }
        Map<Item, Integer> others = new HashMap<>();
        boolean knife = false;
        for (CuttingBoardRecipe recipe : Cutting.all(view.level())) {
            if (toolKind(recipe).equals(KNIFE)) {
                knife = true;
            } else {
                Item tool = firstItem(Cutting.tool(recipe));
                if (tool != null) {
                    others.merge(tool, 1, Integer::sum);
                }
            }
        }
        if (knife) {
            tabs.add(new RecipeBook.Tab(KNIFE, stack(FarmersDelightContent.id("iron_knife"))));
        }
        others.entrySet().stream().max(Map.Entry.<Item, Integer>comparingByValue()
                        .thenComparing(entry -> BuiltInRegistries.ITEM.getKey(entry.getKey()).toString(), Comparator.reverseOrder()))
                .ifPresent(most -> tabs.add(new RecipeBook.Tab(TOOLS, new ItemStack(most.getKey()))));
        return tabs;
    }

    @Override
    public String memory() {
        return CuttingBoardStation.ID.toString();
    }

    /** What a cut is made with: the knife, or another tool. */
    private static String toolKind(CuttingBoardRecipe recipe) {
        ItemStack knife = stack(FarmersDelightContent.id("iron_knife"));
        Ingredient tool = Cutting.tool(recipe);
        if (tool.test(knife)) {
            return KNIFE;
        }
        return tool.isEmpty() ? KNIFE : TOOLS;
    }

    /** The cuts {@code recipe} makes: the game hands them out as templates, one stack each. */
    private static List<ItemStack> results(CuttingBoardRecipe recipe) {
        return recipe.getResults().stream().map(ItemStackTemplate::create).toList();
    }

    /** The first item {@code ingredient} takes, or null when it takes none. */
    private static Item firstItem(Ingredient ingredient) {
        return ingredient.items().map(Holder::value).findFirst().orElse(null);
    }

    /** The item {@code id} names as one of it, or nothing for a dish the pack no longer has. */
    private static ItemStack stack(Identifier id) {
        return BuiltInRegistries.ITEM.getOptional(id).map(ItemStack::new).orElse(ItemStack.EMPTY);
    }

    /**
     * Whether the player holds shift: the game reads the modifiers of a click off its own event now, and offers no {@code Screen} of
     * the keyboard's state, so the window's keys are asked.
     */
    private static boolean shift() {
        Window window = Minecraft.getInstance().getWindow();
        return InputConstants.isKeyDown(window, InputConstants.KEY_LSHIFT) || InputConstants.isKeyDown(window, InputConstants.KEY_RSHIFT);
    }

    static void received(ListTag book) {
        received = book;
    }

    /**
     * Reads the dishes the server sent: 232 recipes of the board and its addons. Read where the book is opened, once per set of
     * recipes — the server sends the same set again at every click, and a set already read is not read again.
     */
    private static void readDishes(ListTag book) {
        try {
            List<RecipeBook.Page> read = new ArrayList<>();
            List<Ingredient> others = new ArrayList<>();
            for (AssemblyRecipes.Assembly dish : AssemblyRecipes.read(book)) {
                if (!dish.inBook()) {
                    others.addAll(dish.ingredients());
                    continue;
                }
                List<Ingredient> ingredients = new ArrayList<>(dish.ingredients());
                // What goes down first is listed first.
                ingredients.add(0, ingredients.remove(dish.base()));
                ItemStack result = dish.stack();
                read.add(new RecipeBook.Page(dish.id(), result, ingredients, List.of(), null, false, DISHES));
            }
            readFrom = book;
            dishes = List.copyOf(read);
            unlisted = List.copyOf(others);
            version++;
        } catch (RuntimeException broken) {
            // One broken set of recipes must not lose the book: it keeps the pages it has.
            com.pockyl.handson_delight.HandsOnDelight.LOGGER.warn("Could not read the board's dishes", broken);
        }
    }

    private List<RecipeBook.Page> dishes(StationView view) {
        ListTag book = received;
        if (!book.isEmpty() && (readFrom == null || !book.equals(readFrom))) {
            readDishes(book);
        }
        return dishes;
    }

    /** The dishes as last read, a new number each time they change. */
    @Override
    public int version(StationView view) {
        // Cheap on purpose: the book asks for it every frame, and reading the dishes here compared 232 recipes each time.
        return version;
    }

    /** Whether {@code stack} goes into one of the dishes put together on the board. */
    boolean goesIntoADish(StationView view, ItemStack stack) {
        return dishes(view).stream().anyMatch(page -> page.ingredients().stream().anyMatch(ingredient -> ingredient.test(stack)))
                || unlisted.stream().anyMatch(ingredient -> ingredient.test(stack));
    }

    /**
     * A dish picked in the book is the one the board makes as soon as the layers make it, even if they could grow into more; what it
     * takes is laid from the inventory, one set or, with shift, a batch.
     */
    @Override
    public void picked(StationView view, RecipeBook.Page page) {
        // By its recipe: the dishes are read anew when the server sends them, the page may be of the list before.
        if (dishes(view).stream().anyMatch(dish -> dish.key().equals(page.key()))) {
            CompoundTag pick = new CompoundTag();
            pick.putString(CuttingBoardStation.DISH, page.key().toString());
            pick.putBoolean(CuttingBoardStation.ALL, shift());
            view.sendAction(CuttingBoardStation.ACTION_PICK, pick);
        }
    }

    /** The dish the layers make, else what lies on the board to be cut. */
    @Override
    public Object current(StationView view) {
        String dish = view.state().data().getStringOr(CuttingBoardStation.DISH, "");
        if (!dish.isEmpty()) {
            for (RecipeBook.Page page : dishes(view)) {
                if (BuiltInRegistries.ITEM.getKey(page.dish().getItem()).toString().equals(dish)) {
                    return page.key();
                }
            }
        }
        ItemStack onBoard = view.state().getItem(CuttingBoardStation.BOARD_SLOT);
        return Cutting.recipesFor(view.level(), onBoard).stream().findFirst().map(recipe -> Cutting.id(view.level(), recipe)).orElse(null);
    }

    @Override
    public List<ItemStack> inStation(StationView view) {
        List<ItemStack> there = new ArrayList<>(BoardLogic.layers(view.state()));
        there.add(view.state().getItem(CuttingBoardStation.BOARD_SLOT));
        return there;
    }
}
